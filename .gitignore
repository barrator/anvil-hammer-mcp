live-test*.json
live-*-report.json
!live-test.config.example.json
live-test-report.json
live-template-report.json
live-write-report.json
live-bbcode-report.json
live-content-report.json

# Local data folders (backups, index, logs)
data/
backups/
logs/
*.log
