{
  "name": "anvil-hammer-mcp",
  "version": "0.1.0",
  "description": "A safe MCP server for reading and enriching your own World Anvil worlds.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "anvil-hammer-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barrator/anvil-hammer-mcp.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.7",
    "eslint": "10.16.0",
    "eslint-config-prettier": "10.1.9",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
