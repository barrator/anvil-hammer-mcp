{
  "name": "anvil-hammer-mcp",
  "version": "0.2.0",
  "description": "A safe MCP server for reading and enriching your own World Anvil worlds.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "anvil-hammer-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barrator/anvil-hammer-mcp.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts live/read.live.test.ts",
    "test:live:templates": "vitest run --config vitest.live.config.ts live/template-probe.live.test.ts",
    "test:live:write": "vitest run --config vitest.live.config.ts live/write.live.test.ts",
    "test:live:cleanup": "vitest run --config vitest.live.config.ts live/cleanup.live.test.ts",
    "test:live:bbcode": "vitest run --config vitest.live.config.ts live/bbcode-probe.live.test.ts",
    "test:live:content": "vitest run --config vitest.live.config.ts live/content.live.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.11",
    "eslint": "10.16.0",
    "eslint-config-prettier": "10.1.9",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
