# Copy to .env next to docker-compose.yml, then adjust. No secret goes here:
# keys and the passphrase hash are files in ./secrets/.

# Public https address of the server, origin only (no path). The MCP URL to give
# Claude is this address followed by /mcp. Without a domain, sslip.io gives a
# name for an IP address, e.g. for 203.0.113.7:
WA_PUBLIC_URL=https://wa.203-0-113-7.sslip.io

# Image version to run: a release tag without the leading "v".
ANVIL_HAMMER_VERSION=0.2.0

# Port on 127.0.0.1 where the reverse proxy reaches the gateway.
WA_HTTP_PORT=8080

# Resource limits.
WA_SERVER_MEMORY=256m
WA_SERVER_CPUS=1.0
WA_NODE_HEAP_MB=160
WA_GATEWAY_MEMORY=64m
WA_GATEWAY_CPUS=0.5

# Retention, in days.
WA_BACKUP_RETENTION_DAYS=90
WA_LOG_RETENTION_DAYS=180

# wa_delete stays off unless you need it.
WA_ENABLE_DELETE=false
